{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek Harness",
        "width": 980,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "url": "index.html",
        "backgroundColor": "#f9fafb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop client",
    "longDescription": "Tauri shell around the DeepSeek Harness web UI (Node.js sidecar).",
    "resources": [
      "resources/dsh-runtime/**/*",
      "resources/node.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
